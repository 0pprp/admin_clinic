# Production environment example. Copy to a secret store or host env.
# Never commit real secrets. Placeholders only.

ASPNETCORE_ENVIRONMENT=Production

# Managed PostgreSQL. Do not use localhost:5433.
# Prefer Ssl Mode=Require. Do not disable server certificate validation.
ConnectionStrings__DefaultConnection=Host=CHANGE_ME;Port=5432;Database=mohammed_raouf;Username=CHANGE_ME;Password=CHANGE_ME;Ssl Mode=Require;Trust Server Certificate=false

Jwt__Issuer=MohammedRaouf
Jwt__Audience=MohammedRaouf.Web
Jwt__SigningKey=CHANGE_ME_AT_LEAST_32_BYTES
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

App__PublicUrl=https://example.com
Cors__AllowedOrigins__0=https://example.com

# Gmail SMTP (App Password) or Disabled until credentials exist.
Email__Provider=Smtp
Email__FromName=العيادة الإدارية
Email__FromAddress=CHANGE_ME@gmail.com
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__UseStartTls=true
Email__Smtp__Username=CHANGE_ME@gmail.com
Email__Smtp__Password=CHANGE_ME_APP_PASSWORD
Email__Google__ClientId=CHANGE_ME.apps.googleusercontent.com
Email__OtpLength=6
Email__OtpLifetimeMinutes=10

# Public Google client id for the Next.js Google button (build-time).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

Video__Provider=BunnyStream
Video__TokenLifetimeMinutes=10
Video__Bunny__LibraryId=CHANGE_ME
Video__Bunny__CdnHostname=iframe.mediadelivery.net
Video__Bunny__TokenKey=CHANGE_ME

ForwardedHeaders__AllowAllProxies=true

# Temporary production admin bootstrap only. Remove after the first admin exists.
# SEED_ADMIN_ALLOW_NON_DEVELOPMENT=true
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Public frontend value only (baked into the Next.js build). Not a backend secret.
NEXT_PUBLIC_SITE_URL=https://example.com
