FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/MohammedRaouf.Domain/ src/MohammedRaouf.Domain/
COPY src/MohammedRaouf.Contracts/ src/MohammedRaouf.Contracts/
COPY src/MohammedRaouf.Application/ src/MohammedRaouf.Application/
COPY src/MohammedRaouf.Infrastructure/ src/MohammedRaouf.Infrastructure/
COPY src/MohammedRaouf.Api/ src/MohammedRaouf.Api/
RUN dotnet publish src/MohammedRaouf.Api/MohammedRaouf.Api.csproj -c Release -o /app/publish --no-self-contained

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "MohammedRaouf.Api.dll"]
