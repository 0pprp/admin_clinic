# PostgreSQL (development only)
POSTGRES_DB=mohammed_raouf_dev
POSTGRES_USER=mr_dev
POSTGRES_PASSWORD=change_me_dev_only

# Backend
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5433;Database=mohammed_raouf_dev;Username=mr_dev;Password=change_me_dev_only

# Optional development admin seed. Leave empty in source control.
# Prefer user-secrets so the password never enters Git:
#   dotnet user-secrets init --project src/MohammedRaouf.Api
#   dotnet user-secrets set "SEED_ADMIN_EMAIL" "dev-admin@localhost.test" --project src/MohammedRaouf.Api
#   dotnet user-secrets set "SEED_ADMIN_PASSWORD" "use-a-local-only-password" --project src/MohammedRaouf.Api
# Admin seed runs only in Development unless SEED_ADMIN_ALLOW_NON_DEVELOPMENT=true is set explicitly.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Frontend
# The browser calls same-origin /api/* (Next rewrite in development, Caddy in production).
# Do not put backend secrets in NEXT_PUBLIC_* — those values are public.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_PROXY_ORIGIN=http://127.0.0.1:5000
