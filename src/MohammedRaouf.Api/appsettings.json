{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Connection": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "App": {
    "PublicUrl": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Email": {
    "Provider": "Logging",
    "FromName": "العيادة الإدارية",
    "FromAddress": "",
    "OtpLength": 6,
    "OtpLifetimeMinutes": 10,
    "OtpMaxAttempts": 5,
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseStartTls": true,
      "Username": "",
      "Password": ""
    },
    "Google": {
      "ClientId": ""
    }
  },
  "Video": {
    "Provider": "Unavailable",
    "TokenLifetimeMinutes": 10,
    "Bunny": {
      "LibraryId": "",
      "CdnHostname": "iframe.mediadelivery.net",
      "TokenKey": ""
    }
  },
  "ForwardedHeaders": {
    "AllowAllProxies": false
  },
  "Jwt": {
    "Issuer": "MohammedRaouf",
    "Audience": "MohammedRaouf.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "SessionRefreshTokenDays": 1
  },
  "AuthCookies": {
    "AccessCookieName": "mr_access",
    "RefreshCookieName": "mr_refresh",
    "Path": "/"
  },
  "RateLimiting": {
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60,
    "RegisterPermitLimit": 3,
    "RegisterWindowSeconds": 600,
    "ForgotPasswordPermitLimit": 3,
    "ForgotPasswordWindowSeconds": 900,
    "ResetPasswordPermitLimit": 5,
    "ResetPasswordWindowSeconds": 600,
    "RefreshPermitLimit": 30,
    "RefreshWindowSeconds": 60,
    "ActivationRedeemPermitLimit": 5,
    "ActivationRedeemWindowSeconds": 60,
    "ProgressPermitLimit": 120,
    "ProgressWindowSeconds": 60,
    "ConsultationPermitLimit": 3,
    "ConsultationWindowSeconds": 900,
    "ContactPermitLimit": 5,
    "ContactWindowSeconds": 600
  },
  "ActivationCodes": {
    "ExpirationDays": 30
  }
}
